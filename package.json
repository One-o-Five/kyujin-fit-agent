{
  "name": "kyujin-fit-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @kyujin/api dev",
    "dev:web": "pnpm --filter @kyujin/web dev",
    "build": "pnpm -r build",
